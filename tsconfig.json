{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@prodigal/ui/*": ["packages/ui/*"],
      "@prodigal/utils/*": ["packages/utils/*"]
    }
  },
  "include": [
    "apps",
    "packages",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
