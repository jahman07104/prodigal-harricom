# HarriCom Backend Environment Configuration
# Copy this file to .env and fill in production values

# Database connection string
# For SQLite (development/testing): sqlite:///./harricom.db
# For PostgreSQL (production): postgresql://user:password@host:5432/harricom_db
DATABASE_URL=sqlite:///./harricom.db

# Admin API token for protected endpoints (/payments/webhooks/diagnostics, etc)
# Required for production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=

# Stripe webhook secret (from Stripe Dashboard → Webhooks → Payment Link endpoint)
# Get from: https://dashboard.stripe.com/webhooks
# Required if accepting Stripe payments
STRIPE_WEBHOOK_SECRET=

# Stripe secret key. Keep this server-side only; never add it to the static site.
# Get from: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=

# Allowed browser origins for Stripe's success and cancel redirects.
# Include only deployed sites, comma-separated.
STRIPE_CHECKOUT_ALLOWED_ORIGINS=https://harricom.netlify.app

# Prodigal offerings available through the secure checkout endpoint. Create each
# Price in Stripe first, then map a stable product code to its Stripe Price ID.
# Example:
# STRIPE_PRODUCT_CATALOG_JSON={"prodigal-consultation":{"title":"Prodigal Consultation","price_id":"price_..."}}
STRIPE_PRODUCT_CATALOG_JSON=

# WiPay webhook secret (from WiPay Dashboard)
# Required if accepting WiPay payments
WIPAY_WEBHOOK_SECRET=

# Comma-separated origins allowed to POST events
# In production, lock this to your actual domain(s)
# Example: https://harricom.com,https://www.harricom.com
ALLOWED_ORIGINS=*

# Server port (optional, defaults to 8000)
# Automatically set by most deployment platforms
PORT=8000

# Environment mode (development or production)
# Use production for live deployments
ENVIRONMENT=development
